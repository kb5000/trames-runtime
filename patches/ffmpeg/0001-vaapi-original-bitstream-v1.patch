+// av1C packing follows FFmpeg's upstream VideoToolbox AV1 path (Jan Ekstrom,
+// Ruslan Chernenko, Martin Storsjo, LGPL-2.1-or-later). Keep original sequence
+// and complete frame OBUs; stateless VA tile data cannot reconstruct them.
+static int trames_av1_issue(AVCodecContext *avctx)
+{
+    const AV1DecContext *s = avctx->priv_data;
+    const AV1RawSequenceHeader *seq = s->raw_seq;
+    VAAPIAV1DecContext *ctx = avctx->internal->hwaccel_priv_data;
+    VAAPIDecodePicture *pic = s->cur_frame.hwaccel_picture_private;
+    uint8_t *configuration, *data;
+    size_t size = 0, offset = 0;
+    int ret;
+    if (!s->seq_data_ref || s->seq_data_ref->size > 65532) return AVERROR_INVALIDDATA;
+    configuration = av_malloc(s->seq_data_ref->size + 4);
+    if (!configuration) return AVERROR(ENOMEM);
+    configuration[0] = 0x81;
+    configuration[1] = seq->seq_profile << 5 | seq->seq_level_idx[0];
+    configuration[2] = seq->seq_tier[0] << 7 | seq->color_config.high_bitdepth << 6 |
+        seq->color_config.twelve_bit << 5 | seq->color_config.mono_chrome << 4 |
+        seq->color_config.subsampling_x << 3 | seq->color_config.subsampling_y << 2 |
+        seq->color_config.chroma_sample_position;
+    configuration[3] = seq->initial_display_delay_present_flag && seq->initial_display_delay_present_for_this_op[0] ?
+        0x10 | seq->initial_display_delay_minus_1[0] : 0;
+    memcpy(configuration + 4, s->seq_data_ref->data, s->seq_data_ref->size);
+    ret = ff_vaapi_trames_configuration(avctx, pic, 2, configuration, s->seq_data_ref->size + 4);
+    av_free(configuration);
+    if (ret < 0) goto fail;
+    for (int i = ctx->trames_start_unit; i <= ctx->trames_end_unit; i++) {
+        size += s->current_obu.units[i].data_size;
+        if (size > INT_MAX) { ret = AVERROR_INVALIDDATA; goto fail; }
+    }
+    data = av_malloc(size);
+    if (!data) { ret = AVERROR(ENOMEM); goto fail; }
+    for (int i = ctx->trames_start_unit; i <= ctx->trames_end_unit; i++) {
+        const CodedBitstreamUnit *unit = &s->current_obu.units[i];
+        memcpy(data + offset, unit->data, unit->data_size); offset += unit->data_size;
+    }
+    ret = ff_vaapi_decode_make_param_buffer(avctx, pic, 0x54520002, data, size);
+    av_free(data);
+    if (ret < 0) goto fail;
+    return ff_vaapi_decode_issue(avctx, pic);
+fail:
+    ff_vaapi_decode_cancel(avctx, pic);
+    return ret;
+}
