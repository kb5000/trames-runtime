+// Preserve the original unescaped parser parameter sets, including fields that
+// stateless VAPictureParameterBufferHEVC does not retain. This uses the same
+// RBSP escaping rule as FFmpeg's native VideoToolbox parameter-set path.
+static size_t trames_hevc_escape(uint8_t *out, const uint8_t *data, size_t size)
+{
+    size_t n = 0;
+    for (size_t i = 0; i < size; i++) {
+        if (i + 2 < size && !data[i] && !data[i+1] && data[i+2] <= 3) {
+            if (out) { out[n] = 0; out[n+1] = 0; out[n+2] = 3; }
+            n += 3; i++;
+        } else {
+            if (out) out[n] = data[i];
+            n++;
+        }
+    }
+    return n;
+}
+static int trames_hevc_configuration(AVCodecContext *avctx, VAAPIDecodePicture *pic)
+{
+    const HEVCContext *h = avctx->priv_data;
+    const HEVCPPS *pps = h->pps;
+    const HEVCSPS *sps = pps->sps;
+    const HEVCVPS *vps = sps->vps;
+    const uint8_t *sets[] = {vps->data, sps->data, pps->data};
+    size_t sizes[] = {vps->data_size, sps->data_size, pps->data_size};
+    size_t total = 12, lengths[3], offset = 0;
+    uint8_t *data;
+    int ret;
+    for (int i = 0; i < 3; i++) {
+        if (sizes[i] < 2 || sizes[i] > 65536) return AVERROR_INVALIDDATA;
+        lengths[i] = trames_hevc_escape(NULL, sets[i], sizes[i]);
+        total += lengths[i];
+    }
+    if (total > 65536) return AVERROR_INVALIDDATA;
+    data = av_malloc(total);
+    if (!data) return AVERROR(ENOMEM);
+    for (int i = 0; i < 3; i++) {
+        AV_WB32(data + offset, lengths[i]); offset += 4;
+        offset += trames_hevc_escape(data + offset, sets[i], sizes[i]);
+    }
+    ret = ff_vaapi_trames_configuration(avctx, pic, 1, data, total);
+    av_free(data);
+    return ret;
+}
